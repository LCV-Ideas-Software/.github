{
  "name": "@lcv-ideas-software/github-slack-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --strict --outdir dist",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:check": "wrangler types --check --config=wrangler.jsonc",
    "types:generate": "wrangler types --config=wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
