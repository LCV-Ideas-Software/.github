{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-slack-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "upload_source_maps": true,
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "SLACK_RELAY_SIGNING_ACTIVE_SLOT": "next",
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-slack-alerts-db",
      "database_id": "cf070eb0-32d9-4ee0-9516-d469833cdc77",
      "migrations_dir": "migrations",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_WEBHOOK_SECRET",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-webhook-secret",
    },
    {
      "binding": "SLACK_ALERTS_WORKFLOW_WEBHOOK_URL",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-workflow-url",
    },
    {
      "binding": "SLACK_ACTIVITY_WORKFLOW_WEBHOOK_URL",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-activity-workflow-url",
    },
    // O binding SLACK_BOT_TOKEN (ADR-002 §5, decisão 11) foi REMOVIDO desta
    // revisão de propósito: este arquivo aciona o deploy automático no
    // merge, e o token de hoje carrega groups:history/groups:read — um
    // merge exporia o histórico do canal privado ao Worker ANTES da redução
    // de escopo e rotação que o §12, item 8, exige como pré-requisito
    // (achado da revisão). O binding re-entra no mesmo commit em que o
    // operador confirmar o token novo com escopo só chat:write:
    //   { "binding": "SLACK_BOT_TOKEN",
    //     "store_id": "df90c0935ba1460899c3c2c457548a90",
    //     "secret_name": "github-slack-alerts-bot-token" }
    {
      // ADR-002 §5, decisão 9: /status protegido por segredo compartilhado.
      // O mesmo valor vive no repositório como ALERTS_STATUS_SECRET, para o
      // vigia autenticar. Criados os dois lados em 16/08/2026.
      "binding": "ALERTS_STATUS_SECRET",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-status-secret",
    },
    {
      "binding": "SLACK_RELAY_SIGNING_SECRET",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-relay-signing-secret",
    },
    {
      "binding": "SLACK_RELAY_SIGNING_SECRET_NEXT",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-relay-signing-secret-next",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ALERT_QUEUE",
        "queue": "github-slack-alerts",
      },
      {
        "binding": "ACTIVITY_QUEUE",
        "queue": "github-slack-activity",
      },
    ],
    "consumers": [
      {
        "queue": "github-slack-alerts",
        "dead_letter_queue": "github-slack-alerts-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 2,
      },
      {
        "queue": "github-slack-alerts-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 1,
      },
      {
        "queue": "github-slack-activity",
        "dead_letter_queue": "github-slack-activity-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "retry_delay": 2,
      },
      {
        "queue": "github-slack-activity-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "max_concurrency": 1,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
