{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-slack-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "upload_source_maps": true,
  "placement": {
    "mode": "smart",
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-slack-alerts-db",
      "database_id": "cf070eb0-32d9-4ee0-9516-d469833cdc77",
      "migrations_dir": "migrations",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_WEBHOOK_SECRET",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-webhook-secret",
    },
    {
      // ADR-002 §5, decisão 11: transporte chat.postMessage. O binding
      // esteve REMOVIDO até a rotação do §12 item 8 (o arquivo aciona
      // deploy no merge, e o token anterior carregava groups:*). Rotação
      // executada pelo operador em 16/08/2026 ~22:00: escopos reduzidos a
      // chat:write, token antigo revogado (auth.revoke ok:true; auth.test
      // com ele devolve account_inactive), valor novo no Secrets Store.
      "binding": "SLACK_BOT_TOKEN",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-bot-token",
    },
    {
      // ADR-002 §5, decisão 9: /status protegido por segredo compartilhado.
      // O mesmo valor vive no environment `alerts-watchdog` do repositório
      // como ALERTS_STATUS_SECRET, para o vigia autenticar (repo-level foi
      // removido — §12 item 3). Criados os dois lados em 16/08/2026;
      // rotacionados em conjunto em 17/08/2026 (piso de 32 bytes).
      "binding": "ALERTS_STATUS_SECRET",
      "store_id": "df90c0935ba1460899c3c2c457548a90",
      "secret_name": "github-slack-alerts-status-secret",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ALERT_QUEUE",
        "queue": "github-slack-alerts",
      },
    ],
    "consumers": [
      {
        // ADR-002 §5, decisão 8: SEM fila de descarte — ela era um segundo
        // mecanismo de entrega com política própria. E max_retries no
        // mínimo: o consumidor sempre confirma, então retentativa de
        // plataforma só existiria no crash — e crash pertence ao cron (a
        // linha fica pendente e é recarimbada). Mensagem de crash é
        // descartada SEM perda: a fonte de verdade é a linha no D1.
        // max_retries: 0 foi aceito pela API e validado no primeiro
        // deploy (17/08/2026).
        "queue": "github-slack-alerts",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0,
        "max_concurrency": 1,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
