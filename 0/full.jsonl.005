__firebase_create_app","mcp__plugin_firebase_firebase__firebase_create_project","mcp__plugin_firebase_firebase__firebase_deploy","mcp__plugin_firebase_firebase__firebase_deploy_status","mcp__plugin_firebase_firebase__firebase_get_environment","mcp__plugin_firebase_firebase__firebase_get_project","mcp__plugin_firebase_firebase__firebase_get_sdk_config","mcp__plugin_firebase_firebase__firebase_get_security_rules","mcp__plugin_firebase_firebase__firebase_init","mcp__plugin_firebase_firebase__firebase_list_apps","mcp__plugin_firebase_firebase__firebase_list_projects","mcp__plugin_firebase_firebase__firebase_login","mcp__plugin_firebase_firebase__firebase_logout","mcp__plugin_firebase_firebase__firebase_read_resources","mcp__plugin_firebase_firebase__firebase_update_environment","mcp__plugin_firebase_firebase__firebase_validate_security_rules","mcp__plugin_firebase_firebase__firestore_add_document","mcp__plugin_firebase_firebase__firestore_create_backup_schedule","mcp__plugin_firebase_firebase__firestore_create_database","mcp__plugin_firebase_firebase__firestore_create_index","mcp__plugin_firebase_firebase__firestore_delete_backup","mcp__plugin_firebase_firebase__firestore_delete_backup_schedule","mcp__plugin_firebase_firebase__firestore_delete_database","mcp__plugin_firebase_firebase__firestore_delete_document","mcp__plugin_firebase_firebase__firestore_delete_index","mcp__plugin_firebase_firebase__firestore_get_backup","mcp__plugin_firebase_firebase__firestore_get_backup_schedule","mcp__plugin_firebase_firebase__firestore_get_database","mcp__plugin_firebase_firebase__firestore_get_document","mcp__plugin_firebase_firebase__firestore_get_index","mcp__plugin_firebase_firebase__firestore_list_backup_schedules","mcp__plugin_firebase_firebase__firestore_list_backups","mcp__plugin_firebase_firebase__firestore_list_collections","mcp__plugin_firebase_firebase__firestore_list_databases","mcp__plugin_firebase_firebase__firestore_list_documents","mcp__plugin_firebase_firebase__firestore_list_indexes","mcp__plugin_firebase_firebase__firestore_query_collection","mcp__plugin_firebase_firebase__firestore_update_backup_schedule","mcp__plugin_firebase_firebase__firestore_update_database","mcp__plugin_firebase_firebase__firestore_update_document","mcp__plugin_firebase_firebase__functions_get_logs","mcp__plugin_firebase_firebase__functions_list_functions","mcp__plugin_firebase_firebase__messaging_send_message","mcp__plugin_firebase_firebase__realtimedatabase_get_data","mcp__plugin_firebase_firebase__realtimedatabase_set_data","mcp__plugin_firebase_firebase__remoteconfig_get_template","mcp__plugin_firebase_firebase__remoteconfig_update_template","mcp__plugin_firebase_firebase__storage_get_object_download_url","mcp__ultrabrain__ultrabrain_analyze","mcp__ultrabrain__ultrabrain_branch","mcp__ultrabrain__ultrabrain_export","mcp__ultrabrain__ultrabrain_history","mcp__ultrabrain__ultrabrain_merge","mcp__ultrabrain__ultrabrain_metrics","mcp__ultrabrain__ultrabrain_reset","mcp__ultrabrain__ultrabrain_review","mcp__ultrabrain__ultrabrain_server_info","mcp__ultrabrain__ultrabrain_start","mcp__ultrabrain__ultrabrain_status","mcp__ultrabrain__ultrabrain_templates","mcp__ultrabrain__ultrabrain_think","mcp__ultrabrain__ultrabrain_update","mcp__ultrabrain__ultrabrain_validate"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"surfacedNames":["mcp__claude_ai_Adobe_for_creativity__adobe_mandatory_init","mcp__claude_ai_Adobe_for_creativity__create_visual_design_express_skill","mcp__claude_ai_Adobe_for_creativity__export_html_to_express","mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update"],"surfacedDefinitions":[{"name":"mcp__claude_ai_Adobe_for_creativity__adobe_mandatory_init","listing":"44771d4a73251c88","definition":{"name":"mcp__claude_ai_Adobe_for_creativity__adobe_mandatory_init","description":"Mandatory initialization step for this gateway. This tool MUST be called first, before invoking any other tool exposed by this server, every single time — regardless of which specific tool the user's request maps to.\n\nThis applies to every tool on this gateway without exception, including (but not limited to): asset_search, asset_add_file, asset_preview_file, image_remove_background, image_apply_lens_blur, image_apply_gaussian_blur, image_fill_area, image_vectorize, document_render_layout, document_convert_pdf, animate_design, search_design, font_recommend, font_preview, extract_brand, video_resize, video_render, video_create_quick_cut, media_summarize, media_enhance_speech, markdown_to_pdf, pdf_combine, pdf_operation_status, pdf_redact, create_firefly_board, and every Firefly Boards and Acrobat tool.\n\nCall this tool with no arguments as the very first tool call of the conversation, even if the user's request already names one specific tool by name (e.g. \"resize this video\", \"remove the background\") — call adobe_mandatory_init first, then proceed to the tool the user actually asked for. Do not skip this step just because the target tool's own description doesn't mention it.\n\nREQUIRED FIRST: Call adobe_mandatory_init once at the start of the conversation (if you haven't already) before using this tool.","input_schema":{"type":"object","properties":{"skill_name":{"default":"","description":"Identifier of the skill being invoked, e.g. 'adobe-animate-design'. When provided, a skill invocation event is recorded.","title":"Skill Name","type":"string"},"skill_version":{"default":"","description":"Version of the skill, e.g. '0.1.0'. Required when skill_name is provided.","maxLength":32,"title":"Skill Version","type":"string"}},"title":"adobe_mandatory_initArguments"},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Adobe_for_creativity__create_visual_design_express_skill","listing":"58dd64e94e2570a8","definition":{"name":"mcp__claude_ai_Adobe_for_creativity__create_visual_design_express_skill","description":"Returns the visual-design playbook — markdown guidance on combining suggest_type_palettes, recommend_fonts, and export_html_to_express to author a polished visual design as self-contained HTML.\n\nWHAT THIS SKILL IS: You author every visual design as HTML, and this skill teaches you how to author it well. The HTML is the source artifact — it can be delivered as an Adobe Express document, derived into a standalone file (PPTX, PDF, image), or both. There is no such thing as an \"Express HTML document\": HTML is *imported into* Express, producing a native Express document. Producing a PPTX (or any other file) does NOT exclude this skill, and calling it does NOT force creating an Express document. Never decline this skill because \"the final artifact is a PPTX / not Express.\"\n\nWHEN TO CALL IT: Call this for ANY visual-design / fixed-canvas request — poster, flyer, slide, presentation/deck, invitation, card, certificate, infographic, social graphic, brochure, menu, multi-page document, and the like — whatever final file format the user names (PPTX, PDF, image, or Adobe Express). Call it first, read the returned markdown, and follow the steps it lays out.\n\nWHEN NOT TO CALL IT: Do NOT call it for non-design tasks, or for responsive web / app / mobile UIs, dashboards, websites, or viewport-adaptive components (wireframing) — use the `frontend-design` skill for those. Also skip it for requests it can't author (editing an existing PSD or video, pure photo retouching).\n\nASK BEFORE PRODUCING: Unless the user already stated the destination clearly, use AskUserQuestion to ask how to deliver the design — an Adobe Express document, a standalone file (e.g. PPTX/PDF/image), or both — before producing the final artifact. For template-friendly intents (invitations, flyers, cards, social posts) where `search_design` is available, also ask whether to start from an Adobe Express template (`search_design`) or a net-new design. Then proceed per the answer: export to Express only when chosen; otherwise author the HTML here and derive the requested file.\n\nThis tool is read-only and has no side effects.\n\nREQUIRED FIRST: Call adobe_mandatory_init once at the start of the conversation (if you haven't already) before using this tool.","input_schema":{"type":"object","properties":{"intent":{"type":"string","description":"Optional short description of the design task. The skill text is the same regardless; this is captured for analytics only."},"sessionId":{"type":"string","description":"Random, non-identifying conversation label (not a credential, access key, or personal data) from structuredContent.sessionId of any prior tool result in this conversation. Pass the same value on every follow-up tool call for the entire chat."}},"additionalProperties":false},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Adobe_for_creativity__export_html_to_express","listing":"02fbebe7bd8f13ff","definition":{"name":"mcp__claude_ai_Adobe_for_creativity__export_html_to_express","description":"Convert an HTML document into an Adobe Express project and return the editor URL. Supply the HTML in exactly one of two ways: inline via `html`, or a public HTTPS `url` the importer fetches. Run `html_export_readiness_skill` first — it decides whether to send the HTML inline or via a hosted `url` (and handles any upload); you don't pick the transport here.\n\nALWAYS call `html_export_readiness_skill` immediately before EVERY call to this tool — the first export, every re-export after editing the HTML, and every retry. Re-validate each time: edits since the last check (even to HTML you generated or already validated) can reintroduce structural, font, or layout problems, and across a long edit session it is easy to lose track of what changed. There is no origin-based exemption — running it on freshly generated HTML is cheap because the skill confirms quickly when nothing is wrong. Skip only when the user explicitly asks to export without validation.\n\nKeep the HTML self-contained — external network references (Adobe Fonts / Typekit, public CDNs) must be publicly reachable.\n\nOn success the response includes `slide_count` and, per slide, the importer's normalized HzHTML (`slides[].html`) — Express's internal DOM representation of the slide, not your original input. Inspect it to confirm the import matched your intent (text present, fonts preserved, nothing dropped or repositioned) before presenting the result.\n\nWhen the HTML originates from a Claude Design project, pass the project ID as `claude_design_project_id`.\n\nREQUIRED FIRST: Call adobe_mandatory_init once at the start of the conversation (if you haven't already) before using this tool.","input_schema":{"type":"object","properties":{"html":{"type":"string","minLength":1,"description":"Inline HTML document to convert. Pass the full validated document text here verbatim — exactly as it stands after validation, with no transformation, re-encoding, truncation, or staging; the value is the document itself, not a path or reference. The readiness skill decides whether to send the HTML inline or via `url` (and handles any hosting) — you don't choose here. Base64-embedded assets (images, fonts, SVG, any `data:` URI) are fully supported inline. Provide exactly one of `html` or `url`."},"url":{"type":"string","format":"uri","description":"Public HTTPS URL the importer fetches the HTML from. Must be on an importer-allowed host: `*.adobe.com` (an Adobe Creative Cloud storage download URL for AfC-uploaded HTML) or `*.claudeusercontent.com` (a Claude Design bundle); URLs on any other host are rejected. The readiness skill decides between this and inline `html` (and handles any hosting). Provide exactly one of `html` or `url`."},"slideSelector":{"type":"string","description":"Optional override for the CSS selector identifying slide containers. If omitted, the importer reads `<meta name=\"hz:slide-selector\">` from the HTML (falling back to '.slide'). Normally leave unset — self-describing HTML carries its own selector."},"slides":{"type":"string","description":"Slide selection spec, e.g. 'all' or '1,3-5'. Defaults to 'all'."},"canvasWidth":{"type":"integer","minimum":1,"description":"Optional global override for canvas width in pixels, applied to every slide. If omitted, the importer derives each slide's width from the HTML (`data-canvas-width` / `hz:canvas-width` metadata, or the root's rendered size). Normally leave unset."},"canvasHeight":{"type":"integer","minimum":1,"description":"Optional global override for canvas height in pixels, applied to every slide. If omitted, the importer derives each slide's height from the HTML (`data-canvas-height` / `hz:canvas-height` metadata, or the root's rendered size). Normally leave unset."},"docName":{"type":"string","description":"Name of the produced document. Defaults to 'imported-document'."},"claude_design_project_id":{"type":"string","description":"Claude Design project ID. When present, indicates the HTML originates from a Claude Design project."},"sessionId":{"type":"string","description":"Random, non-identifying conversation label (not a credential, access key, or personal data) from structuredContent.sessionId of any prior tool result in this conversation. Pass the same value on every follow-up tool call for the entire chat."}},"additionalProperties":false},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__batch","listing":"b18caec4513bd82d","definition":{"name":"mcp__claude_ai_Claude_Docs__batch","description":"Create a doc, or apply several operations to one doc atomically.","input_schema":{"type":"object","properties":{"batch":{"type":"array"},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"create":{"type":"object"}},"required":["kind"]},"verbose":{"type":"boolean"},"opId":{"type":"string"}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__guide","listing":"1f2c30a590811b06","definition":{"name":"mcp__claude_ai_Claude_Docs__guide","description":"Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].","input_schema":{"type":"object","properties":{"items":{"type":"array","description":"topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine."}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__update","listing":"b1347b8d2c5727e2","definition":{"name":"mcp__claude_ai_Claude_Docs__update","description":"Edit a tab's contents, rename a doc or tab, or change a stored value.","input_schema":{"type":"object","properties":{"ref":{"type":"object","properties":{"object":{"type":"string","enum":["project","file","node","utterance","enum"]},"id":{"type":"string"}},"required":["object","id"]},"engine":{"type":"string"},"payload":{"anyOf":[{"type":"object"},{"type":"string"}]},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"version":{"type":"string"}},"required":["kind","id"]},"verbose":{"type":"boolean"},"opId":{"type":"string"},"answering":{"type":"string","maxLength":64}},"required":["ref","payload"]},"eager_input_streaming":true}}]},"type":"attachment","uuid":"3bcbea38-d987-476e-b7c4-e39a9e5e68cb","timestamp":"2026-10-30T04:01:53.847Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nmcp__claude_ai_Adobe_for_creativity__adobe_mandatory_init\nmcp__claude_ai_Adobe_for_creativity__create_visual_design_express_skill\nmcp__claude_ai_Adobe_for_creativity__export_html_to_express\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to 