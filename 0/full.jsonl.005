  instrumentation.uiAutomation.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_BACK)\n        waitFor(\"chart-wheel\", 60_000)''','''        scrollTop(\"synastry-screen\"); capture(\"07-sinastria\")\n        backToChart()''')\ns=s.replace('''        try { compose.onNodeWithTag(\"locality-screen\", useUnmergedTree = true).performScrollToNode(hasTestTag(\"locality-calculate\")) } catch (_: Throwable) { }\n        capture(\"08-localidade\")''','''        scrollTop(\"locality-screen\"); capture(\"08-localidade\")''')\nassert s.count('backToChart()')==3 and 'scrollTop(\"locality-screen\")' in s\nopen(p,'w',encoding='utf-8',newline='\\n').write(s); print('patched')\nEOF","description":"Adiciona voltar-até-o-mapa e rolagem ao topo nas telas de resultado do roteiro"},"caller":{"type":"direct"}}]}}
