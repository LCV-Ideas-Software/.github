|  2 +-\n play/release-notes/pt-BR.txt                       |  2 +-\n 13 files changed, 128 insertions(+), 20 deletions(-)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers\\app\\src\\androidTest\\kotlin\\dev\\lcv\\astrologo\\PlayListingCaptures.kt","hunks":[{"oldStart":1,"oldLines":144,"newStart":0,"newLines":0,"lines":["-/* Temporary capture driver for the Play listing screenshots (1.0.0). Not versioned: deleted before commit. */","-package dev.lcv.astrologo","-","-import android.app.Application","-import android.graphics.Bitmap","-import androidx.compose.ui.semantics.SemanticsProperties","-import androidx.compose.ui.semantics.getOrNull","-import androidx.compose.ui.test.SemanticsMatcher","-import androidx.compose.ui.test.hasTestTag","-import androidx.compose.ui.test.hasText","-import androidx.compose.ui.test.junit4.createEmptyComposeRule","-import androidx.compose.ui.test.onAllNodesWithTag","-import androidx.compose.ui.test.onFirst","-import androidx.compose.ui.test.onNodeWithTag","-import androidx.compose.ui.test.performClick","-import androidx.compose.ui.test.performScrollTo","-import androidx.compose.ui.test.performScrollToIndex","-import androidx.compose.ui.test.performScrollToNode","-import androidx.test.core.app.ActivityScenario","-import androidx.test.ext.junit.runners.AndroidJUnit4","-import androidx.test.platform.app.InstrumentationRegistry","-import dev.lcv.astrologo.data.BirthDatabase","-import dev.lcv.astrologo.data.BirthDraft","-import dev.lcv.astrologo.data.BirthValidation","-import dev.lcv.astrologo.data.validateBirthDraft","-import java.io.File","-import kotlinx.coroutines.runBlocking","-import org.junit.Assert.assertTrue","-import org.junit.Rule","-import org.junit.Test","-import org.junit.runner.RunWith","-","-@RunWith(AndroidJUnit4::class)","-class PlayListingCaptures {","-    @get:Rule val compose = createEmptyComposeRule()","-    private val instrumentation = InstrumentationRegistry.getInstrumentation()","-    private val application = instrumentation.targetContext.applicationContext as Application","-    private val out = File(application.getExternalFilesDir(null), \"play-capturas\").apply { mkdirs() }","-","-    private fun profile(id: String, name: String, date: String, time: String, city: String, lat: String, lon: String) =","-        (validateBirthDraft(BirthDraft(name, date, time, city, lat, lon, \"America/Sao_Paulo\"), id = id) as BirthValidation.Valid).profile","-","-    private fun capture(name: String) {","-        compose.waitForIdle(); Thread.sleep(700); compose.waitForIdle()","-        val shot = requireNotNull(instrumentation.uiAutomation.takeScreenshot())","-        File(out, \"$name.png\").outputStream().use { assertTrue(shot.compress(Bitmap.CompressFormat.PNG, 100, it)) }","-    }","-    private fun exists(tag: String) = compose.onAllNodesWithTag(tag, useUnmergedTree = true).fetchSemanticsNodes().isNotEmpty()","-    /** Lazy lists compose only visible rows: scroll the container until the row exists, then wait for it. */","-    private fun waitFor(tag: String, timeout: Long = 60_000, container: String? = null) {","-        val deadline = System.currentTimeMillis() + timeout","-        while (!exists(tag)) {","-            if (container != null && exists(container)) {","-                try { compose.onNodeWithTag(container, useUnmergedTree = true).performScrollToNode(hasTestTag(tag)) } catch (_: Throwable) { }","-            }","-            compose.waitForIdle()","-            if (exists(tag)) break","-            if (System.currentTimeMillis() > deadline) throw AssertionError(\"tag '$tag' not found within ${timeout}ms (container=$container)\")","-            Thread.sleep(400)","-        }","-    }","-    private fun click(tag: String, container: String? = null) {","-        waitFor(tag, container = container)","-        val node = compose.onNodeWithTag(tag, useUnmergedTree = true)","-        try { node.performScrollTo() } catch (_: AssertionError) { } // nodes outside a scroll container (e.g. chart-back)","-        node.performClick(); compose.waitForIdle()","-    }","-","-    private fun backToChart() {","-        repeat(4) {","-            instrumentation.uiAutomation.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_BACK)","-            try { waitFor(\"chart-wheel\", 8_000); return } catch (_: AssertionError) { }","-        }","-        waitFor(\"chart-wheel\", 60_000)","-    }","-    private fun scrollTop(container: String) {","-        try { compose.onNodeWithTag(container, useUnmergedTree = true).performScrollToIndex(0) } catch (_: Throwable) { }","-        compose.waitForIdle()","-    }","-","-    @Test fun captureEightScreens() {","-        try { run() } catch (failure: Throwable) {","-            val device = androidx.test.uiautomator.UiDevice.getInstance(instrumentation)","-            device.takeScreenshot(File(out, \"zz-falha.png\")); device.dumpWindowHierarchy(File(out, \"zz-falha.xml\"))","-            File(out, \"zz-falha.txt\").writeText(failure.stackTraceToString())","-            throw failure","-        }","-    }","-","-    private fun run() {","-        val ana = profile(\"ficha-ana\", \"Ana Beatriz\", \"1990-05-15\", \"14:30\", \"Rio de Janeiro\", \"-22.9068\", \"-43.1729\")","-        val carlos = profile(\"ficha-carlos\", \"Carlos Eduardo\", \"1985-11-22\", \"08:15\", \"São Paulo\", \"-23.5505\", \"-46.6333\")","-        runBlocking { val dao = BirthDatabase.get(application).profiles(); dao.save(carlos); dao.save(ana) }","-        ActivityScenario.launch(MainActivity::class.java)","-","-        // 1. Home (the home never lists people; they live on the history screen behind open-chart-history)","-        waitFor(\"profiles\"); waitFor(\"open-chart-history\", container = \"profiles\"); Thread.sleep(600)","-        compose.onNodeWithTag(\"profiles\", useUnmergedTree = true).performScrollToIndex(0)","-        compose.waitForIdle(); capture(\"01-inicio\")","-","-        // Carlos first (so synastry has a second saved chart); chart-back returns to the history screen","-        click(\"open-chart-history\", container = \"profiles\"); waitFor(\"profile-${carlos.id}\", container = \"chart-history\")","-        click(\"calculate-${carlos.id}\", container = \"chart-history\"); waitFor(\"chart-wheel\", 120_000); click(\"chart-back\"); waitFor(\"chart-history\")","-","-        // 2. Ana: chart wheel (overview)","-        click(\"calculate-${ana.id}\", container = \"chart-history\"); waitFor(\"chart-wheel\", 120_000)","-        capture(\"02-mapa-natal\")","-","-        // 3. Positions tab","-        click(\"chart-tab-positions\"); Thread.sleep(500); capture(\"03-posicoes\")","-","-        // 4. Readings tab","-        click(\"chart-tab-readings\"); Thread.sleep(500); capture(\"04-leituras\")","-","-        // 5. Element library (free explanations)","-        click(\"chart-tab-overview\")","-        click(\"chart-element-library\", container = \"chart-screen\"); waitFor(\"chart-detail\", 60_000); Thread.sleep(800); capture(\"05-biblioteca\")","-        click(\"chart-detail-close\")","-","-        // 6. Transits","-        click(\"chart-transits\", container = \"chart-screen\"); waitFor(\"transit-screen\"); click(\"transit-now\", container = \"transit-screen\"); click(\"transit-calculate\", container = \"transit-screen\")","-        waitFor(\"transit-export-pdf\", 120_000, container = \"transit-screen\"); Thread.sleep(800)","-        scrollTop(\"transit-screen\"); capture(\"06-transitos\")","-        backToChart()","-","-        // 7. Synastry","-        click(\"chart-synastry\", container = \"chart-screen\"); waitFor(\"synastry-screen\")","-        // Consent first; the choices are saved charts (snapshot ids), so pick the first synastry-choose-* node","-        val consent = hasText(application.getString(R.string.parity_synastry_consent))","-        compose.onNodeWithTag(\"synastry-screen\", useUnmergedTree = true).performScrollToNode(consent); compose.waitForIdle()","-        compose.onNode(consent, useUnmergedTree = true).performClick(); compose.waitForIdle()","-        val choose = SemanticsMatcher(\"synastry-choose-*\") { it.config.getOrNull(SemanticsProperties.TestTag)?.startsWith(\"synastry-choose-\") == true }","-        compose.onNodeWithTag(\"synastry-screen\", useUnmergedTree = true).performScrollToNode(choose); compose.waitForIdle()","-        compose.onAllNodes(choose, useUnmergedTree = true).onFirst().performClick(); compose.waitForIdle()","-        waitFor(\"synastry-export-pdf\", 120_000, container = \"synastry-screen\"); Thread.sleep(800)","-        scrollTop(\"synastry-screen\"); capture(\"07-sinastria\")","-        backToChart()","-","-        // 8. Locality map","-        click(\"chart-locality\", container = \"chart-screen\"); waitFor(\"locality-screen\"); click(\"locality-calculate\", container = \"locality-screen\")","-        waitFor(\"locality-export-pdf\", 180_000, container = \"locality-screen\"); Thread.sleep(1500)","-        scrollTop(\"locality-screen\"); capture(\"08-localidade\")","-    }","-}"]}],"deleted":true}],"moreFiles":0,"changedFiles":["C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers\\app\\src\\androidTest\\kotlin\\dev\\lcv\\astrologo\\PlayListingCaptures.kt"]}},"sandboxed":false,"sourceToolAssistantUUID":"fe48a3d5-25d9-4241-b0aa-802752340d44","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers","sessionId":"3815f8b0-8c60-4890-93a0-2fcc4c634f88","version":"2.1.314","gitBranch":"HEAD","slug":"glistening-tumbling-prism"}
