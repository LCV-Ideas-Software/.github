QUOTA_PROJECT }}\n          PACKAGE: ${{ vars.PLAY_PACKAGE_NAME }}\n          TRACK: ${{ inputs.track }}\n          BUNDLE: ${{ steps.artifact.outputs.path }}\n          LOCAL_SHA: ${{ steps.artifact.outputs.sha256 }}\n          NOTES_FILE: play/release-notes/pt-BR.txt\n          NOTES_LANGUAGE: pt-BR\n          RELEASE_STATUS: ${{ inputs.release_status }}\n        run: |\n          set -euo pipefail\n          # `--fail-with-body` escreve o corpo do erro na saída padrão e sai 22.\n          # Quando essa saída ia para uma variável ou para /dev/null, a mensagem\n          # do Google Play — que é quem diz o que está errado — se perdia, e um\n          # HTTP 400 chegava ao log como \"curl: (22)\" e nada mais. Esta função\n          # guarda corpo e status, devolve o corpo em caso de sucesso e o imprime\n          # em caso de falha. Diagnóstico sai por stderr de propósito: algumas\n          # chamadas são escritas com `>/dev/null`, que engoliria a mensagem se\n          # ela saísse pela saída padrão junto com o corpo de sucesso.\n          play() {\n            local rotulo=$1; shift\n            local corpo status\n            corpo=$(mktemp)\n=== 300-345\n                       -H 'Content-Type: application/octet-stream' \\\n                       --data-binary \"@$BUNDLE\" \\\n                       \"$upload/$PACKAGE/edits/$edit/bundles?uploadType=media\")\n          remote_sha=$(echo \"$response\" | jq -r '.sha256')\n          version=$(echo \"$response\" | jq -r '.versionCode')\n\n          # The gate: if Google Play did not receive the exact bytes this job\n          # built, the upload is not this build and must not reach a track.\n          if [ \"$remote_sha\" != \"$LOCAL_SHA\" ]; then\n            echo \"::error::Digest mismatch. built=$LOCAL_SHA received=$remote_sha\"\n            exit 1\n          fi\n\n          # As notas da versão viajam na atualização da trilha, que é onde a API\n          # Android Publisher as recebe: `releases[].releaseNotes[]`, do tipo\n          # `LocalizedText {language, text}`, com `language` em BCP-47. O corpo é\n          # montado por jq porque o texto é prosa em português, com acento, aspas\n          # e quebra de linha, e interpolação de shell o corromperia. `name` fica\n          # de fora de propósito: a API o deriva do `versionName`, então a release\n          # se chama pelo número do próprio aplicativo, sem uma segunda cópia da\n          # versão para manter em dia.\n          payload=$(jq -n \\\n            --arg track \"$TRACK\" \\\n            --arg code \"$version\" \\\n            --arg language \"$NOTES_LANGUAGE\" \\\n            --arg status \"$RELEASE_STATUS\" \\\n            --rawfile notes \"$NOTES_FILE\" \\\n            '{\n               track: $track,\n               releases: [{\n                 versionCodes: [$code],\n                 status: $status,\n                 releaseNotes: [{ language: $language, text: ($notes | sub(\"\\n+$\"; \"\")) }]\n               }]\n             }')\n\n          play \"atualizar a trilha $TRACK\" -X PUT \\\n            -H \"Authorization: Bearer $TOKEN\" \\\n            -H \"x-goog-user-project: $QUOTA_PROJECT\" \\\n            -H 'Content-Type: application/json' \\\n            -d \"$payload\" \\\n            \"$api/$PACKAGE/edits/$edit/tracks/$TRACK\" >/dev/null\n\n          play \"confirmar a edição\" -X POST \\\n            -H \"Authorization: Bearer $TOKEN\" \\\n            -H \"x-goog-user-project: $QUOTA_PROJECT\" \\","is_error":false}]}}
