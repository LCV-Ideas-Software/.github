9 0 Oct 30 00:59 ../\ndrwxr-xr-x 1 lcvle 197609 0 Oct 30 00:58 play-capturas/","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"511a0862-bbd6-48af-a2d7-dc5de75860a3","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers","sessionId":"3815f8b0-8c60-4890-93a0-2fcc4c634f88","version":"2.1.314","gitBranch":"HEAD","slug":"glistening-tumbling-prism"}
