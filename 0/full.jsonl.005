( private val savedState: SavedStateHandle, private val loadSnapshot: suspend (String) -> ChartSnapshot?, private val observeRuns: (String) -> Flow<List<LocalLocalityRun>>, \n\n--- construcao em testes:\n===== PaidFlowState: definicao\ndata class PaidFlowState(val available: Boolean = false, val identity: PaidIdentityState = PaidIdentityState.UNAVAILABLE, val displayPrice: String? = null, val selection: PaidSourceSelection = PaidSourceSelection(null, null), val primaryChart: PaidSourceOption? = null, val chartOptions: List<PaidSourceOption> = emptyList(), val transitOptions: List<PaidSourceOption> = emptyList(), val localityOptions: List<PaidSourceOption> = emptyList(), val sourcesLoading: Boolean = false, val sourcesReadFailed: Boolean = false, val selectionMissing: Boolean = false, val canEditSelection: Boolean = false, val selectionDiffers: Boolean = false, val universal: PaidUniversalState = PaidUniversalState()) { val busy: Boolean get() = universal.busy }  data class PaidSourceSelection(val transitRunId: String?, val secondarySnapshotId: String?, val localityRunId: String? = null) /** Labels only; the complete sa\n\n--- construcao em testes:\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\paid\\PaidAnalysisScreenTest.kt:37:        val state = PaidFlowState(available = true, identity = PaidIdentityState.SIGNED_IN,\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\paid\\PaidAnalysisScreenTest.kt:53:        var state by mutableStateOf(PaidFlowState(available = true, identity = PaidIdentityState.SIGNED_OUT,\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\paid\\PaidAnalysisScreenTest.kt:70:        val state = PaidFlowState(available = true, identity = PaidIdentityState.SIGNED_IN,\n===== SavedAnalysisState: definicao\ndata class SavedAnalysisState( val snapshotId: String? = null, val loading: Boolean = false, val readFailed: Boolean = false, val items: List<SavedAnalysisItem> = emptyList(), val selectedJobId: String? = null, val selected: VerifiedLocalAnalysisDelivery? = null, )  /** Only committed, DAO-verified typed deliveries; no generation, billing or legacy HTML promotion. */ class SavedAnalysisViewModel internal constructor( application: Application, private val saved: SavedStateHandle, private val readChart: suspend (String) -> ChartSnapshot?, private val observeJobs: (String) -> Flow<List<LocalAnalysisJob>>, \n\n--- construcao em testes:","is_error":false},{"tool_use_id":"toolu_01Ya4VJdk4k9AMSUdhZGwrG8","type":"tool_result","content":"=== BirthSaveRestorationTest 40-100\n    @get:Rule val compose = createComposeRule()\n    private val restoration = StateRestorationTester(compose)\n    private val instrumentation = InstrumentationRegistry.getInstrumentation()\n    private val application = instrumentation.targetContext.applicationContext as Application\n    private val store = ViewModelStore()\n    private val dao = ControlledDao()\n    private lateinit var model: BirthProfileViewModel\n    private val original = (validateBirthDraft(BirthDraft(\"Original record\", \"1990-05-15\", \"14:30\",\n        \"Rio\", \"-22.9068\", \"-43.1729\", \"America/Sao_Paulo\"), id = \"save-restoration\") as BirthValidation.Valid).profile\n\n    @After fun clearModel() { instrumentation.runOnMainSync { store.clear() } }\n\n    @Test fun reflectedCommitCompletesSaveAfterRestoration() = exercise(readFailure = false)\n\n    @Test fun readFailureDoesNotErasePendingCommitAfterRestoration() = exercise(readFailure = true)\n\n    @Test fun actualWriteFailureDoesNotAnnounceASavedProfile() {\n        startPendingSave()\n        restoration.emulateSavedInstanceStateRestore()\n        dao.failWrite = true\n        dao.releaseWrite.complete(Unit)\n        compose.waitUntil(10_000) { !model.state.value.busy && model.state.value.error == StoreError.WRITE }\n        assertNull(dao.committed)\n        compose.onNodeWithText(application.getString(R.string.close)).performClick()\n        dao.emit(listOf(original))\n        compose.onNodeWithTag(\"profile-editor\").assertIsDisplayed()\n        compose.onNodeWithTag(\"saved-notice\").assertDoesNotExist()\n    }\n\n    private fun exercise(readFailure: Boolean) {\n        startPendingSave()\n        restoration.emulateSavedInstanceStateRestore()\n        compose.onNodeWithTag(\"profile-editor\").assertIsDisplayed()\n        if (readFailure) {\n            dao.failObservation()\n            compose.waitUntil(10_000) { model.state.value.readFailed }\n            compose.onNodeWithText(application.getString(R.string.close)).performClick()\n        }\n        dao.releaseWrite.complete(Unit)\n        compose.waitUntil(10_000) { !model.state.value.busy }\n        val committed = dao.committed\n        assertNotNull(\"The gated write actually completed\", committed)\n        assertEquals(\"Updated record\", committed!!.name)\n        // The pre-restoration callback cannot complete the new composition on its own.\n        compose.onNodeWithTag(\"profile-editor\").assertIsDisplayed()\n        if (readFailure) compose.onNodeWithTag(\"retry-read\").performScrollTo().performClick()\n        dao.emit(listOf(committed))\n        compose.waitUntil(10_000) { model.state.value.profiles == listOf(committed) && !model.state.value.readFailed }\n        compose.onNodeWithTag(\"chart-history\").assertIsDisplayed()\n        compose.onNodeWithTag(\"saved-notice\").performScrollTo().assertIsDisplayed()\n        assertEquals(1, dao.writes)\n    }\n\n    private fun startPendingSave() {\n        instrumentation.runOnMainSync {\n            model = BirthProfileViewModel(application) { dao }\n            store.put(\"save-restoration\", model)\n        }\n        restoration.setContent { AstrologoTheme { AstrologoApp(model) } }\n        dao.emit(listOf(original))\n        compose.waitUntil(10_000) { !model.state.value.loading }\n=== SavedAnalysisIntegrationTest 60-130\n        val row = ChartSnapshotCodec.create(profile, AstroEngine.calculate(Instant.ofEpochSecond(profile.instantEpochSecond),\n            profile.latitude, profile.longitude), 1000, \"analysis-pdf-chart\")\n        val unit = SemanticUnit(\"sun\", AnalysisDomain.NATAL, \"/sun\", \"Synthetic PDF fact\")\n        val facts = listOf(\"sun@0:${unit.codePointCount}\")\n        val blueprint = AnalysisDocumentBlueprint(title = \"Saved rich analysis\", sections = listOf(\n            ExpectedAnalysisSection(\"rich\", \"Rich interpretation\", facts, icon = AnalysisIcon.SUN),\n            ExpectedAnalysisSection(\"highlight\", \"Highlighted section\", facts, AnalysisSectionStyle.HIGHLIGHT),\n            ExpectedAnalysisSection(\"synthesis\", \"Final synthesis\", facts, AnalysisSectionStyle.SYNTHESIS,\n                role = AnalysisSectionRole.SYNTHESIS)))\n        val input = AnalysisInput(\"synthetic-pdf-v1\", \"Synthetic native PDF fixture.\", listOf(unit),\n            \"Explicit test context, not a new paid canonical input.\", blueprint)\n        val job = AnalysisJob.create(\"pdf-job\", AnalysisPlanner().plan(input, ModelBudget(\"synthetic\", 25384, 16384,\n            nativeMaximumOutputTokens = 16384,\n            contextWindowMode = AnalysisContextWindowMode.SHARED_INPUT_OUTPUT,\n            outputPlanning = AnalysisOutputPlanning(0, 1, 0, 1, \"synthetic output planning fixture\")),\n            AnalysisDocumentWire.documentSchema, counter))\n        val name = \"analysis-pdf-${UUID.randomUUID()}.db\"\n        val db = Room.databaseBuilder<BirthDatabase>(context, name).setDriver(BundledSQLiteDriver()).build()\n        databases.add(name to db)\n        run {\n            db.profiles().save(profile)\n            db.charts().insertVerified(row)\n            var record = db.analyses().createPrepared(job, row.id, row.payloadSha256, AnalysisDeliveryPlan.create(job), 2000)\n            record = db.analyses().save(record.checkpointHash, record.decode().recordVerifiedPurchase(\"synthetic-pdf-purchase\"))\n            suspend fun accept(): LocalAnalysisJob {\n                val begun = record.decode().beginNextAttempt()\n                val attempt = requireNotNull(begun.activeAttempt)\n                record = db.analyses().save(record.checkpointHash, begun.markDispatched(attempt.id).settleAttempt(attempt.id,\n                    AnalysisCostSettlement(AnalysisCostSource.ESTIMATED, \"0.01\", \"synthetic-${attempt.id}\")))\n                val current = record.decode()\n                val expected = AnalysisDocumentDelivery.expectedStage(current,\n                    AnalysisDeliveryPlan.decode(requireNotNull(record.deliveryPlanJson), current), attempt.stageId)\n                val document = AnalysisDocument(contractHash = expected.hash, sections = expected.sections.map { section ->\n                    AnalysisDocumentSection(section.id, listOf(AnalysisDocumentBlock.Paragraph(rich(\"${section.id}FinalText\"), section.requiredFactIds)))\n                })\n                val stage = current.stages.single { it.id == attempt.stageId }\n                val notes = if (stage.kind == AnalysisStageKind.SYNTHESIS) emptyList()\n                    else listOf(SynthesisNote(\"Synthetic notes\", stage.evidenceIds))\n                return db.analyses().acceptStructured(record.id, record.checkpointHash, attempt.id,\n                    GenerationCompletion.COMPLETE, document, notes).job\n            }\n            assertEquals(1, job.plan.fragments.size)\n            record = accept()\n            val round = AnalysisIntegrator().nextRound(record.decode(),\n                IntegrationSchemas(AnalysisDocumentWire.notesSchema, AnalysisDocumentWire.documentSchema), counter)\n            record = db.analyses().save(record.checkpointHash, record.decode().scheduleIntegration(round))\n            record = accept()\n            assertEquals(AnalysisPhase.COMPLETE, record.decode().phase)\n            val delivery = if (commit) db.analyses().commitTypedDelivery(record.id, record.checkpointHash, 3000) else null\n            return Fixture(db, row, record, delivery)\n        }\n    }\n\n    @Test fun onlyCommittedDeliveryAppearsAndReaderRestoresExactSelectionWithBothExportChoices(): Unit = runBlocking {\n        val f = fixture(commit = false)\n        val saved = SavedStateHandle()\n        val model = withContext(Dispatchers.Main) { newModel(f, saved).also { it.selectChart(f.row.id) } }\n        assertTrue(ready(model).items.isEmpty())\n        val delivery = f.db.analyses().commitTypedDelivery(f.job.id, f.job.checkpointHash, 3000)\n        ready(model) { it.items.size == 1 }\n        var map: String? = null\n        var combined: Pair<String, AnalysisPdfSelection>? = null\n        compose.setContent {\n            val state by model.state.collectAsState()\n            MaterialTheme { SavedAnalysisScreen(state, model::closeAnalysis, model::open, model::retry,\n                { map = it }, { id, selection -> combined = id to selection }) }\n        }\n        compose.onNodeWithTag(\"open-analysis-${f.job.id}\").performClick()\n        ready(model) { it.selected != null }\n        compose.onNodeWithTag(\"analysis-export\").performClick()\n        compose.onNodeWithTag(\"export-map-analysis\").performClick()","is_error":false}]}}
