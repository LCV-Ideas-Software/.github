on.takeScreenshot())\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\chart\\ChartModuleNavigationTest.kt:218:        assertTrue(device.takeScreenshot(File(directory, \"$name.png\")))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt:75:        device.takeScreenshot(File(proof, \"saf-final-window.png\"))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt:92:        device.takeScreenshot(File(proof, \"saf-picker-before-recreation.png\"))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt:112:        device.takeScreenshot(File(proof, \"saf-cancel-after-recreation.png\"))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt:135:        device.takeScreenshot(File(proof, \"saf-save-picker-after-recreation.png\"))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt:162:        device.takeScreenshot(File(proof, \"saf-save-success.png\"))\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\chart\\ChartScreenTest.kt:149:        assertTrue(device.takeScreenshot(File(destination, \"$name-font-$font.png\")))\n=== dispositivos/emuladores\nList of devices attached\r\n\r\nandroid-36/\nandroid-37.0/\npixel_10_api37","is_error":false}]},"uuid":"b02f0ebe-a4c5-4ff0-9f51-2a8f24fb4358","timestamp":"2026-10-30T03:41:51.564Z","toolUseResult":{"stdout":"=== harness de capturas no androidTest\nteste-release\\src\\main\\kotlin\\dev\\lcv\\astrologo\\teste\\release\\BirthProfileMinifiedTest.kt\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\export\\ChartPdfSafTest.kt\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\analysis\\AnalysisDocumentContentTest.kt\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\chart\\AstrologyArtworkTest.kt\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\chart\\ChartAdaptiveTest.kt\napp/src/androidTest\\kotlin\\dev\\lcv\\astrologo\\ui\\chart\\ChartElementReadingTest.kt\napp/src/androidTest\\kotlin\\dev\\lc