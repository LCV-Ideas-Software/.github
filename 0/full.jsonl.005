{"parentUuid":"72d8fc2c-643f-4687-8b2b-aa2b0949e5a5","isSidechain":false,"attachment":{"type":"deferred_tools_record","entries":[{"name":"mcp__google-dev-docs__get_documents","description":"Use this tool to retrieve the full content of a single document or up to 20 documents in a single call. The document names should be obtained from either the `parent` field of results from a call to the `search_documents` tool or the `references` field returned by the `answer_query` tool. Set the `names` parameter to a list of document names (`documents/...`), and cite the authoritative source documents used in your final response.","input_schema":{"type":"object","properties":{"names":{"description":"Required. The names of the documents to retrieve, as returned by the `parent` field of `search_documents` results or the `references` field of `answer_query`. A maximum of 20 documents can be retrieved in one call. The documents are returned in the same order as the `names` in the request. Format: `documents/{uri_without_scheme}` Example: `documents/docs.cloud.google.com/storage/docs/creating-buckets`","items":{"type":"string"},"type":"array"}},"required":["names"],"description":"Request schema for `get_documents`."},"eager_input_streaming":true,"defer_loading":true}]},"type":"attachment","uuid":"a762b370-8ffc-4821-b333-c21f154d2936","timestamp":"2026-10-30T04:24:54.591Z","userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\lcvle\\lcv-workspace\\github-operations","sessionId":"3815f8b0-8c60-4890-93a0-2fcc4c634f88","version":"2.1.314","gitBranch":"HEAD","slug":"glistening-tumbling-prism"}
