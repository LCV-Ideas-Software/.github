d)\n                        addProperty(\"stageKind\", exclusion.stageKind.name)\n                        addProperty(\"groupId\", exclusion.groupId)\n                        addProperty(\"sectionIds\", exclusion.sectionIds.joinToString(\",\"))\n                        addProperty(\"boundary\", exclusion.boundary.name)\n                        addProperty(\"requiredTokens\", exclusion.requiredTokens)\n                        addProperty(\"allowedTokens\", exclusion.allowedTokens)\n                    })\n                }\n=== provider events\n=== messaging\n29:    private fun targets(account: String) = db.collection(\"astrologoMessagingTargets\").document(account)\n30:    private fun device(id: String) = db.collection(\"astrologoMessagingDevices\").document(id)\n31:    fun register(principal: FirebaseAccountVerification.Verified, body: JsonObject): JsonObject {\n60:    fun send(origin: String, reference: String, type: String, accepted: Long = 0, total: Long = 0) {\n81:                } catch (failure: FirebaseMessagingException) {\n89:    fun sendRefund(origin: String, reference: String, alreadyAccepted: Set<String>, accepted: (String, String) -> Unit): Int {\n100:                catch (failure: FirebaseMessagingException) {\n112:    private fun remove(account: String, hash: String, updated: String) {\n120:    @Suppress(\"UNCHECKED_CAST\") private fun entries(raw: Map<String, Any>?): Map<String, Map<String, Any>> =\n124:        internal fun refundMessage(fid: String, reference: String): Message = Message.builder().setFid(fid)","is_error":false},{"tool_use_id":"toolu_016kfKodVJaSX2BehrLnBwgR","type":"tool_result","content":"40:      track:\n50:      release_status:\n52:          Release status. A draft app — one never published — only accepts\n53:          `draft` on production; the first publication is finished in the Console.\n55:        default: completed\n58:          - completed\n59:          - draft\n97:          RELEASE_STATUS: ${{ inputs.release_status }}\n107:          if [ \"$TRACK\" = production ] && [ \"$RELEASE_STATUS\" = completed ] && [ -z \"$PLAY_RELEASE_TOKEN\" ]; then\n181:        if: inputs.track == 'production' && inputs.release_status == 'completed'\n195:            echo \"::error::A Release or draft already uses $TAG; do not upload this version again.\"\n248:          RELEASE_STATUS: ${{ inputs.release_status }}\n328:               track: $track,\n362:      # Native evidence of a completed production edit, distinct from the\n365:        if: success() && inputs.track == 'production' && inputs.release_status == 'completed'\n374:          echo \"- production/completed Play edit committed for versionCode \\`$VERSION_CODE\\`\" >> \"$GITHUB_STEP_SUMMARY\"\n388:          RELEASE_STATUS: ${{ inputs.release_status }}\n422:          if [ \"$RELEASE_STATUS\" = draft ]; then\n427:              echo \"Este aplicativo ainda é um *draft app* — nunca foi publicado —, e a API\"\n428:              echo \"recusa \\`completed\\` nesse estado: *\\\"Only releases with status draft may be\"\n429:              echo \"created on draft app\\\"*. A documentação oficial descreve o caminho: a\"\n435:              echo \"usam \\`completed\\` e gravam a Release normalmente.\"\n521:  # artifact and re-verified on arrival. The Release is created as a draft, the\n558:        # Create the exact source ref atomically, then an identified draft.\n560:        # the created draft/tag because GitHub has no conditional deletion API.\n577:            echo \"::warning::Preserving this attempt's tag $TAG and draft ${owned_release_id:-not-established}; operator review is required before retry.\"\n583:              echo \"- created draft ID: \\`${owned_release_id:-not-established}\\`\"\n596:            echo \"The native PUBLISHED lifecycle includes halted/resumable releases; Google controls current rollout and availability.\"\n630:          draft=$(gh api --method POST \"repos/$GITHUB_REPOSITORY/releases\" \\\n632:            -F draft=true -f \"name=$TAG\" -F generate_release_notes=true -F \"body=@$RUNNER_TEMP/notes.md\")\n633:          owned_release_id=$(jq -er '.id | numbers | select(. > 0 and floor == .)' <<< \"$draft\")\n634:          if ! jq -e --arg tag \"$TAG\" '.draft == true and .tag_name == $tag' <<< \"$draft\" >/dev/null; then\n639:          upload_url=$(jq -er --arg expected \"$expected_upload_url\" '.upload_url | select(. == $expected)' <<< \"$draft\")\n641:          verify_owned_draft() {\n645:              '.id == $id and .tag_name == $tag and .draft == true and .target_commitish == $sha' \\\n654:          verify_owned_draft\n665:          verify_owned_draft\n667:            -F draft=false -f \"tag_name=$TAG\" -f \"target_commitish=$HEAD_SHA\")\n669:            '.id == $id and .tag_name == $tag and .target_commitish == $sha and .draft == false' <<< \"$published\" >/dev/null","is_error":false}]}}
