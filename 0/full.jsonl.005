files.update  PUT androidpublisher/v3/applications/{packageName}/edits/{editId}/apks/{apkVersionCode}/expansionFiles/{expansionFileType}\r\nv3.edits.expansionfiles.upload  POST androidpublisher/v3/applications/{packageName}/edits/{editId}/apks/{apkVersionCode}/expansionFiles/{expansionFileType}\r\nv3.edits.get  GET androidpublisher/v3/applications/{packageName}/edits/{editId}\r\nv3.edits.images.delete  DELETE androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}/{imageType}/{imageId}\r\nv3.edits.images.deleteall  DELETE androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}/{imageType}\r\nv3.edits.images.list  GET androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}/{imageType}\r\nv3.edits.images.upload  POST androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}/{imageType}\r\nv3.edits.insert  POST androidpublisher/v3/applications/{packageName}/edits\r\nv3.edits.listings.delete  DELETE androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}\r\nv3.edits.listings.deleteall  DELETE androidpublisher/v3/applications/{packageName}/edits/{editId}/listings\r\nv3.edits.listings.get  GET androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}\r\nv3.edits.listings.list  GET androidpublisher/v3/applications/{packageName}/edits/{editId}/listings\r\nv3.edits.listings.patch  PATCH androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}\r\nv3.edits.listings.update  PUT androidpublisher/v3/applications/{packageName}/edits/{editId}/listings/{language}\r\nv3.edits.testers.get  GET androidpublisher/v3/applications/{packageName}/edits/{editId}/testers/{track}\r\nv3.edits.testers.patch  PATCH androidpublisher/v3/applications/{packageName}/edits/{editId}/testers/{track}\r\nv3.edits.testers.update  PUT androidpublisher/v3/applications/{packageName}/edits/{editId}/testers/{track}\r\nv3.edits.tracks.creat