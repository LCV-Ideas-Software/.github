{"parentUuid":"0de035b5-6be7-4ac9-9555-e26eb10498db","isSidechain":false,"attachment":{"type":"file","filename":"C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers\\app\\src\\androidTest\\kotlin\\dev\\lcv\\astrologo\\PlayListingCaptures.kt","content":{"type":"text","file":{"filePath":"C:\\Users\\lcvle\\lcv-workspace\\.worktrees\\mp-sweep-404-sdk-headers\\app\\src\\androidTest\\kotlin\\dev\\lcv\\astrologo\\PlayListingCaptures.kt","content":"/* Temporary capture driver for the Play listing screenshots (1.0.0). Not versioned: deleted before commit. */\npackage dev.lcv.astrologo\n\nimport android.app.Application\nimport android.graphics.Bitmap\nimport androidx.compose.ui.test.hasTestTag\nimport androidx.compose.ui.test.junit4.createEmptyComposeRule\nimport androidx.compose.ui.test.onAllNodesWithTag\nimport androidx.compose.ui.test.onNodeWithTag\nimport androidx.compose.ui.test.performClick\nimport androidx.compose.ui.test.performScrollTo\nimport androidx.compose.ui.test.performScrollToNode\nimport androidx.test.core.app.ActivityScenario\nimport androidx.test.ext.junit.runners.AndroidJUnit4\nimport androidx.test.platform.app.InstrumentationRegistry\nimport dev.lcv.astrologo.data.BirthDatabase\nimport dev.lcv.astrologo.data.BirthDraft\nimport dev.lcv.astrologo.data.BirthValidation\nimport dev.lcv.astrologo.data.validateBirthDraft\nimport java.io.File\nimport kotlinx.coroutines.runBlocking\nimport org.junit.Assert.assertTrue\nimport org.junit.Rule\nimport org.junit.Test\nimport org.junit.runner.RunWith\n\n@RunWith(AndroidJUnit4::class)\nclass PlayListingCaptures {\n    @get:Rule val compose = createEmptyComposeRule()\n    private val instrumentation = InstrumentationRegistry.getInstrumentation()\n    private val application = instrumentation.targetContext.applicationContext as Application\n    private val out = File(application.getExternalFilesDir(null), \"play-capturas\").apply { mkdirs() }\n\n    private fun profile(id: String, name: String, date: String, time: String, city: String, lat: String, lon: String) =\n        (validateBirthDraft(BirthDraft(name, date, time, city, lat, lon, \"America/Sao_Paulo\"), id = id) as BirthValidation.Valid).profile\n\n    private fun capture(name: String) {\n        compose.waitForIdle(); Thread.sleep(700); compose.waitForIdle()\n        val shot = requireNotNull(instrumentation.uiAutomation.takeScreenshot())\n        File(out, \"$name.png\").outputStream().use { assertTrue(shot.compress(Bitmap.CompressFormat.PNG, 100, it)) }\n    }\n    private fun exists(tag: String) = compose.onAllNodesWithTag(tag, useUnmergedTree = true).fetchSemanticsNodes().isNotEmpty()\n    /** Lazy lists compose only visible rows: scroll the container until the row exists, then wait for it. */\n    private fun waitFor(tag: String, timeout: Long = 60_000, container: String? = null) {\n        val deadline = System.currentTimeMillis() + timeout\n        while (!exists(tag)) {\n            if (container != null && exists(container)) {\n                try { compose.onNodeWithTag(container, useUnmergedTree = true).performScrollToNode(hasTestTag(tag)) } catch (_: Throwable) { }\n            }\n            compose.waitForIdle()\n            if (exists(tag)) break\n            if (System.currentTimeMillis() > deadline) throw AssertionError(\"tag '$tag' not found within ${timeout}ms (container=$container)\")\n            Thread.sleep(400)\n        }\n    }\n    private fun click(tag: String, container: String? = null) {\n        waitFor(tag, container = container)\n        compose.onNodeWithTag(tag, useUnmergedTree = true).performScrollTo().performClick(); compose.waitForIdle()\n    }\n\n    @Test fun captureEightScreens() {\n        try { run() } catch (failure: Throwable) {\n            val device = androidx.test.uiautomator.UiDevice.getInstance(instrumentation)\n            device.takeScreenshot(File(out, \"zz-falha.png\")); device.dumpWindowHierarchy(File(out, \"zz-falha.xml\"))\n            File(out, \"zz-falha.txt\").writeText(failure.stackTraceToString())\n            throw failure\n        }\n    }\n\n    private fun run() {\n        val ana = profile(\"ficha-ana\", \"Ana Beatriz\", \"1990-05-15\", \"14:30\", \"Rio de Janeiro\", \"-22.9068\", \"-43.1729\")\n        val carlos = profile(\"ficha-carlos\", \"Carlos Eduardo\", \"1985-11-22\", \"08:15\", \"São Paulo\", \"-23.5505\", \"-46.6333\")\n        runBlocking { val dao = BirthDatabase.get(application).profiles(); dao.save(carlos); dao.save(ana) }\n        ActivityScenario.launch(MainActivity::class.java)\n\n        // 1. Home (hero + people further down the lazy list)\n        waitFor(\"profiles\"); waitFor(\"profile-${ana.id}\", container = \"profiles\"); Thread.sleep(600)\n        compose.onNodeWithTag(\"profiles\", useUnmergedTree = true).performScrollToNode(hasTestTag(\"brand-header\"))\n        compose.waitForIdle(); capture(\"01-inicio\")\n\n        // Carlos first (so synastry has a second saved chart), then back home\n        click(\"calculate-${carlos.id}\", container = \"profiles\"); waitFor(\"chart-wheel\", 120_000); click(\"chart-back\"); waitFor(\"profiles\")\n\n        // 2. Ana: chart wheel (overview)\n        click(\"calculate-${ana.id}\", container = \"profiles\"); waitFor(\"chart-wheel\", 120_000)\n        capture(\"02-mapa-natal\")\n\n        // 3. Positions tab\n        click(\"chart-tab-positions\"); Thread.sleep(500); capture(\"03-posicoes\")\n\n        // 4. Readings tab\n        click(\"chart-tab-readings\"); Thread.sleep(500); capture(\"04-leituras\")\n\n        // 5. Element library (free explanations)\n        click(\"chart-tab-overview\")\n        click(\"chart-element-library\", container = \"chart-screen\"); waitFor(\"element-library-index\", 60_000); Thread.sleep(800); capture(\"05-biblioteca\")\n        click(\"chart-detail-close\")\n\n        // 6. Transits\n        click(\"chart-transits\", container = \"chart-screen\"); waitFor(\"transit-screen\"); click(\"transit-now\", container = \"transit-screen\"); click(\"transit-calculate\", container = \"transit-screen\")\n        waitFor(\"transit-export-pdf\", 120_000, container = \"transit-screen\"); Thread.sleep(800)\n        try { compose.onNodeWithTag(\"transit-screen\", useUnmergedTree = true).performScrollToNode(hasTestTag(\"transit-calculate\")) } catch (_: Throwable) { }\n        capture(\"06-transitos\")\n        instrumentation.uiAutomation.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_BACK)\n        waitFor(\"chart-wheel\", 60_000)\n\n        // 7. Synastry\n        click(\"chart-synastry\", container = \"chart-screen\"); waitFor(\"synastry-screen\"); click(\"synastry-choose-${carlos.id}\", container = \"synastry-screen\")\n        waitFor(\"synastry-export-pdf\", 120_000, container = \"synastry-screen\"); Thread.sleep(800)\n        try { compose.onNodeWithTag(\"synastry-screen\", useUnmergedTree = true).performScrollToNode(hasTestTag(\"synastry-screen\")) } catch (_: Throwable) { }\n        capture(\"07-sinastria\")\n        instrumentation.uiAutomation.performGlobalAction(android.accessibilityservice.AccessibilityService.GLOBAL_ACTION_BACK)\n        waitFor(\"chart-wheel\", 60_000)\n\n        // 8. Locality map\n        click(\"chart-locality\", container = \"chart-screen\"); waitFor(\"locality-screen\"); click(\"locality-calculate\", container = \"locality-screen\")\n        waitFor(\"locality-export-pdf\", 180_000, container = \"locality-screen\"); Thread.sleep(1500)\n        try { compose.onNodeWithTag(\"locality-screen\", useUnmergedTree = true).performScrollToNode(hasTestTag(\"locality-calculate\")) } catch (_: Throwable) { }\n        capture(\"08-localidade\")\n    }\n}\n","numLines":122,"startLine":1,"totalLines":122}},"displayPath":"app\\src\\androidTest\\kotlin\\dev\\lcv\\astrologo\\PlayListingCaptures.kt"},"type":"attachment","uuid":"079f5a04-42bc-4b42-98cf-068c3ede6b22","timestamp":"2026-10-30T04:01:53.819Z","rendered":[{"content":"<sy