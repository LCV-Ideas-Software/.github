{"type":"api-request-blob","sessionId":"3815f8b0-8c60-4890-93a0-2fcc4c634f88","hash":"f815a7b1e9fa8cdfe27e7eaf232fc190d809da518ae71b0130dae02bc8294e15","message":{"role":"user","content":[{"tool_use_id":"toolu_015pBtAZmfBB6jkzLyKodmBb","type":"tool_result","content":"7 metrics 11 policies\r\ngen.py\nmetric-astrologo_mp_webhook_outcome.json\nmetric-astrologo_payment_order_missing_at_provider.json\nmetric-astrologo_payment_reconciliation_deferred.json\nmetric-astrologo_payment_reconciliation_failure.json\nmetric-astrologo_preparation_capacity_exceeded.json\nmetric-astrologo_provider_assessment.json\nmetric-astrologo_push_send_failed.json\npolicy-00.json\npolicy-01.json\npolicy-02.json\npolicy-03.json\npolicy-04.json\npolicy-05.json\npolicy-06.json\npolicy-07.json\npolicy-08.json\npolicy-09.json\npolicy-10.json","is_error":false},{"tool_use_id":"toolu_014fWt8yPjnj8CrQHhrcnxwN","type":"tool_result","content":"    fun send(origin: String, reference: String, type: String, accepted: Long = 0, total: Long = 0) {\n        require(type in setOf(\"progress\", \"ready\", \"refund\"))\n        val owners = accounts.resolveGroup(origin).owners\n        val unique = linkedSetOf<String>()\n        for (account in owners) {\n            val values = entries(targets(account).get().get(15, TimeUnit.SECONDS).data)\n            for ((hash, row) in values) {\n                val fid = row[\"fid\"] as String; val updated = row[\"updatedAt\"] as String\n                if (Instant.parse(updated) <= clock.instant().minus(Duration.ofDays(30))) { remove(account, hash, updated); continue }\n                val owner = device(hash).get().get(15, TimeUnit.SECONDS).getString(\"accountHash\")\n                if (owner != account || !unique.add(fid)) continue\n                val data = linkedMapOf(\"type\" to type, \"ref\" to reference)\n                if (type == \"progress\") {\n                    require(accepted >= 0 && total >= accepted)\n                    data[\"accepted\"] = accepted.toString(); data[\"total\"] = total.toString()\n                    data[\"fraction1000\"] = if (total == 0L) \"0\" else ((accepted * 1000 / total).coerceAtMost(990)).toString()\n                    data[\"kind\"] = \"estimate\"\n                }\n                try {\n                    messaging.send(Message.builder().setFid(fid).putAllData(data).setAndroidConfig(AndroidConfig.builder()\n                        .setPriority(if (type == \"ready\") AndroidConfig.Priority.HIGH else AndroidConfig.Priority.NORMAL).build()).build())\n                } catch (failure: FirebaseMessagingException) {\n                    if (failure.messagingErrorCode in setOf(MessagingErrorCode.UNREGISTERED, MessagingErrorCode.INVALID_ARGUMENT))\n                        remove(account, hash, updated)\n                }\n            }\n        }\n    }\n    /** Per-device acceptance is persisted by the outbox; transient FCM failures remain retryable. */\n=== testes\nbackend/src/test/kotlin/dev/lcv/astrologo/backend/executionv2/FirestoreExecutionV2IntegrationTest.kt","is_error":false}]}}
